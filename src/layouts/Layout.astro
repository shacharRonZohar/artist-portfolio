---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header>
      <a href={base} class="logo">Portfolio</a>
      <nav>
        <div class="dropdown">
          <button class="dropdown-trigger">His</button>
          <div class="dropdown-menu">
            <a href={`${base}him/gallery`}>Gallery</a>
            <a href={`${base}him/about`}>About</a>
          </div>
        </div>
        <div class="dropdown">
          <button class="dropdown-trigger">Hers</button>
          <div class="dropdown-menu">
            <a href={`${base}her/gallery`}>Gallery</a>
            <a href={`${base}her/about`}>About</a>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --fg: #1a1a1a;
    --muted: #888;
    --gap: 2rem;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem var(--gap);
    border-bottom: 1px solid #eee;
  }

  .logo {
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.2s;
    padding: 0.25rem 0;
  }
  .dropdown-trigger:hover { color: var(--fg); }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 6px;
    padding: 0.5rem 0;
    min-width: 120px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 0.2s, transform 0.2s;
    z-index: 100;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-menu a {
    text-decoration: none;
    color: var(--fg);
    font-size: 0.9rem;
    padding: 0.4rem 1.2rem;
    transition: background 0.15s, color 0.15s;
  }
  .dropdown-menu a:hover {
    background: #f5f5f5;
    color: var(--fg);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--gap);
  }

  footer {
    text-align: center;
    padding: 2rem;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid #eee;
    margin-top: 4rem;
  }

  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; }

  @media (max-width: 640px) {
    header { padding: 1rem; }
    nav { gap: 1.5rem; }
  }
</style>