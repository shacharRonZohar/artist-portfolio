---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="His About" description="About the artist">
  <article class="about-page">
    <a href={`${base}him/gallery`} class="back">&larr; Gallery</a>

    <div class="about-grid">
      <div class="photo-section">
        <img src={`${base}images/artists/him.jpg`} alt="Portrait" class="portrait" />
        <a href={`${base}cv/his-cv.pdf`} download class="cv-link">
          <span>Download CV</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="content-section">
        <span class="eyebrow">Artist No. 1</span>
        <h1>His Work</h1>
        <div class="statement">
          <p>My creative practice evolves at the intersection of classical academic traditions and modern visual exploration.</p>
          <p>Drawing upon a solid foundation in fine arts and history of arts, my work navigates between structure and emotion, discipline and intuitive expression.</p>
          <p>Deeply inspired by nature, mythology, human psychology, and the complexities of memory, I seek to create paintings that go beyond mere visual decoration. Through a thoughtful dialogue of form, line, and color, I aim to evoke atmospheric, contemplative spaces that invite the viewer into an inner narrative.</p>
          <p>Having absorbed both classical Russian academic training and the vibrant light and energy of the Middle East, my palette and texture reflect a synthesis of cultures. Whether working with narrative figurative compositions or atmospheric imagery, my primary goal is to capture transient emotional states and spark an open-ended dialogue between the artwork and the observer.</p>
        </div>

        <div class="contact">
          <h2>Contact</h2>
          <div class="contact-items">
            <a href="tel:0503701899" class="contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              050-3701899
            </a>
            <a href="https://instagram.com/maxwerttattoo" target="_blank" rel="noopener" class="contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke-linecap="round"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
              </svg>
              @maxwerttattoo
            </a>
            <a href="mailto:" class="contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke-linecap="round"/>
                <path d="M3 7l9 6 9-6" stroke-linecap="round"/>
              </svg>
              Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .about-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .back:hover { color: var(--fg); }

  .about-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .photo-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 2rem;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    background: #f0f0f0;
    border-radius: 4px;
  }

  .cv-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.7rem 1.2rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    transition: border-color 0.2s, background 0.2s;
  }
  .cv-link:hover {
    border-color: var(--fg);
    background: #f5f5f5;
  }

  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .content-section h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .statement {
    color: #444;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .statement code {
    background: #eee;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.85em;
  }

  .contact {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }

  .contact h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .contact-link:hover { color: var(--fg); }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .photo-section { position: static; max-width: 280px; }
  }
</style>