---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const count = (await getCollection('art')).filter((w) => w.data.artist === 'him').length;
---

<Layout title="His About" description="About the artist">
  <article class="about-page">
    <a href={`${base}him/gallery`} class="back">&larr; Gallery</a>

    <div class="about-grid">
      <div class="photo-section">
        <img src={`${base}images/artists/him.svg`} alt="Portrait" class="portrait" />
        <a href={`${base}cv/his-cv.pdf`} download class="cv-link">
          <span>Download CV</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="content-section">
        <span class="eyebrow">Artist No. 1</span>
        <h1>His Work</h1>
        <p class="statement">
          This is where the artist statement goes. Replace this text in
          <code>src/pages/him/about.astro</code> with the actual artist statement —
          a paragraph or two describing the work, its themes, and the artist's
          approach to their medium.
        </p>
        <p class="statement">
          Currently {count} {count === 1 ? 'piece' : 'pieces'} in the gallery.
        </p>

        <div class="contact">
          <h2>Contact</h2>
          <div class="contact-items">
            <a href="mailto:artist@example.com" class="contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke-linecap="round"/>
                <path d="M3 7l9 6 9-6" stroke-linecap="round"/>
              </svg>
              artist@example.com
            </a>
            <a href="https://instagram.com/" target="_blank" rel="noopener" class="contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke-linecap="round"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
              </svg>
              @instagram
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .about-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .back:hover { color: var(--fg); }

  .about-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .photo-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 2rem;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    background: #f0f0f0;
    border-radius: 4px;
  }

  .cv-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.7rem 1.2rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    transition: border-color 0.2s, background 0.2s;
  }
  .cv-link:hover {
    border-color: var(--fg);
    background: #f5f5f5;
  }

  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .content-section h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .statement {
    color: #444;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .statement code {
    background: #eee;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.85em;
  }

  .contact {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }

  .contact h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .contact-link:hover { color: var(--fg); }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .photo-section { position: static; max-width: 280px; }
  }
</style>