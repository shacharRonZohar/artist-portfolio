---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getName, type ArtistSlug } from '../../data/artists';

export async function getStaticPaths() {
  const works = await getCollection('art');
  return works.map((work) => ({
    params: { slug: work.slug },
  }));
}

const base = import.meta.env.BASE_URL;
const { slug } = Astro.params;
const works = await getCollection('art');
const work = works.find((w) => w.slug === slug);

if (!work) {
  return Astro.redirect(base);
}

const artistName = getName(work.data.artist as ArtistSlug);
const { Content } = await render(work);
---

<Layout title={work.data.title} description={work.data.description}>
  <article class="detail">
    <a href={`${base}${work.data.artist}/gallery`} class="back">&larr; {artistName}</a>
    <div class="stage">
      <div class="image-cell">
        <img src={`${base}${work.data.image.replace(/^\//, '')}`} alt={work.data.title} />
      </div>
      <div class="info-cell">
        <div class="info-inner">
          <span class="collection">{work.data.collection}</span>
          <h1>{work.data.title}</h1>
          <dl>
            {work.data.date && <div><dt>Date</dt><dd>{work.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</dd></div>}
            {work.data.medium && <div><dt>Medium</dt><dd>{work.data.medium}</dd></div>}
            {work.data.dimensions && <div><dt>Dimensions</dt><dd>{work.data.dimensions}</dd></div>}
          </dl>
          <div class="description">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .detail {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 180px);
    min-height: 480px;
  }

  .back {
    flex: 0 0 auto;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .back:hover { color: var(--fg); }

  .stage {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 340px);
    gap: 2rem;
    min-height: 0;
  }

  .image-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    border-radius: 4px;
    overflow: hidden;
    min-height: 0;
  }

  .image-cell img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .info-cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
    min-height: 0;
  }

  .info-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .collection {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .info-cell h1 {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.2;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.85rem;
  }

  dl div {
    display: flex;
    gap: 0.4rem;
  }

  dt { color: var(--muted); }
  dd { font-weight: 500; }

  .description {
    color: #333;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .detail {
      height: auto;
      min-height: auto;
    }
    .stage {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .image-cell {
      height: 60vh;
      max-height: 520px;
    }
    .info-cell {
      overflow-y: visible;
    }
  }
</style>