---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About" description="About the artist">
  <article class="about">
    <h1>About</h1>
    <p>Edit this page at <code>src/pages/about.astro</code> to add your bio, statement, and contact info.</p>
  </article>
</Layout>

<style>
  .about {
    max-width: 600px;
    margin: 0 auto;
  }
  .about h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .about p {
    color: #555;
  }
  code {
    background: #eee;
    padding: 0.15em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }
</style>