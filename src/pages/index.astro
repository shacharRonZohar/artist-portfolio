---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allWorks = await getCollection('art');
const himCount = allWorks.filter((w) => w.data.artist === 'him').length;
const herCount = allWorks.filter((w) => w.data.artist === 'her').length;
---

<Layout title="Two Artists" description="A portfolio of two artists">
  <section class="hero">
    <div class="hero-text">
      <h1>Two Artists,<br/>One Canvas</h1>
      <p>A shared portfolio of two distinct voices.</p>
    </div>
    <div class="split">
      <a href={`${base}him`} class="half him">
        <div class="half-content">
          <h2>His Work</h2>
          <p>{himCount} {himCount === 1 ? 'piece' : 'pieces'}</p>
          <span class="cta">View his art &rarr;</span>
        </div>
      </a>
      <a href={`${base}her`} class="half her">
        <div class="half-content">
          <h2>Her Work</h2>
          <p>{herCount} {herCount === 1 ? 'piece' : 'pieces'}</p>
          <span class="cta">View her art &rarr;</span>
        </div>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  .hero-text {
    text-align: center;
    padding: 4rem 2rem 2rem;
  }

  .hero-text h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .hero-text p {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 50vh;
    margin-top: 2rem;
  }

  .half {
    text-decoration: none;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 2rem;
    transition: flex 0.3s ease;
  }

  .him { background: #2b3a4a; }
  .her { background: #7a3b5e; }

  .half:hover { flex: 1.3; }
  .half:hover .cta { transform: translateX(4px); }

  .half-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .half-content h2 {
    font-size: 1.8rem;
    font-weight: 600;
  }

  .half-content p {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .cta {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    display: inline-block;
    transition: transform 0.2s;
  }

  @media (max-width: 640px) {
    .split {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .half { min-height: 30vh; }
  }
</style>