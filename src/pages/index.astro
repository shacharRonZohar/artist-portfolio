---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const works = (await getCollection('art')).sort(
  (a, b) => b.data.order - a.data.order || b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Portfolio" description="A selection of recent work">
  <div class="gallery">
    {works.map((work) => (
      <a href={`${base}art/${work.slug}`} class="card">
        <img src={`${base}${work.data.image.replace(/^\//, '')}`} alt={work.data.title} loading="lazy" />
        <div class="info">
          <h2>{work.data.title}</h2>
          {work.data.medium && <span>{work.data.medium}</span>}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: opacity 0.2s;
  }
  .card:hover { opacity: 0.8; }

  .card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f0f0f0;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info h2 {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .info span {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>