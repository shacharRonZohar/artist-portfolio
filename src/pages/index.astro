---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allWorks = await getCollection('art');
const sortByRecent = (a: typeof allWorks[number], b: typeof allWorks[number]) =>
  b.data.date.getTime() - a.data.date.getTime();

const maxWorks = allWorks.filter((w) => w.data.artist === 'max-wert').sort(sortByRecent);
const kseniaWorks = allWorks.filter((w) => w.data.artist === 'ksenia-wert').sort(sortByRecent);

const maxCover = maxWorks[0]?.data.image;
const kseniaCover = kseniaWorks[0]?.data.image;
const maxCount = maxWorks.length;
const kseniaCount = kseniaWorks.length;
---

<Layout title="Max Wert & Ksenia Wert" description="A portfolio of two artists">
  <section class="hero">
    <div class="hero-intro">
      <span class="eyebrow">A shared portfolio</span>
      <h1>Max & Ksenia Wert</h1>
    </div>
    <div class="split">
      <a href={`${base}max-wert/gallery`} class="panel max" style={maxCover ? `--cover: url('${base}${maxCover.replace(/^\//, '')}')` : ''}>
        <div class="panel-inner">
          <div class="panel-meta">
            <h2>Max Wert</h2>
            <p class="count">{maxCount} {maxCount === 1 ? 'piece' : 'pieces'}</p>
          </div>
          <span class="cta">View work &rarr;</span>
        </div>
      </a>
      <a href={`${base}ksenia-wert/gallery`} class="panel ksenia" style={kseniaCover ? `--cover: url('${base}${kseniaCover.replace(/^\//, '')}')` : ''}>
        <div class="panel-inner">
          <div class="panel-meta">
            <h2>Ksenia Wert</h2>
            <p class="count">{kseniaCount} {kseniaCount === 1 ? 'piece' : 'pieces'}</p>
          </div>
          <span class="cta">View work &rarr;</span>
        </div>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    margin: calc(-1 * var(--gap));
    display: flex;
    flex-direction: column;
  }

  /* Intro */
  .hero-intro {
    text-align: center;
    padding: 4rem 2rem 3rem;
  }

  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .hero-intro h1 {
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .thin { font-weight: 200; }

  /* Split panels */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 55vh;
  }

  .panel {
    position: relative;
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 2.5rem;
    /* Diagonal cut between panels */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    transition: clip-path 0.4s ease;
  }

  /* Textured gradient overlay + artwork preview */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--cover, none);
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease;
    z-index: 0;
  }

  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.85) 100%),
      radial-gradient(circle at 30% 20%, rgba(255,255,255,0.04) 0%, transparent 60%);
    z-index: 1;
    transition: background 0.4s ease;
  }

  .max::after {
    background:
      linear-gradient(180deg, rgba(43,58,74,0.25) 0%, rgba(20,30,40,0.92) 100%),
      radial-gradient(circle at 30% 20%, rgba(255,255,255,0.05) 0%, transparent 60%);
  }

  .ksenia::after {
    background:
      linear-gradient(180deg, rgba(122,59,94,0.25) 0%, rgba(60,25,45,0.92) 100%),
      radial-gradient(circle at 70% 80%, rgba(255,255,255,0.05) 0%, transparent 60%);
  }

  .panel:hover::before { transform: scale(1.06); }
  .panel:hover::after { background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.75) 100%); }
  .max:hover::after {
    background: linear-gradient(180deg, rgba(43,58,74,0.1) 0%, rgba(20,30,40,0.8) 100%);
  }
  .ksenia:hover::after {
    background: linear-gradient(180deg, rgba(122,59,94,0.1) 0%, rgba(60,25,45,0.8) 100%);
  }

  .panel-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .panel-meta { display: flex; flex-direction: column; gap: 0.3rem; }

  .panel-meta h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .count {
    font-size: 0.85rem;
    opacity: 0.65;
    margin-top: 0.15rem;
  }

  .cta {
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: transform 0.2s;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    padding-bottom: 2px;
  }

  .panel:hover .cta {
    transform: translateX(6px);
    border-bottom-color: rgba(255,255,255,0.7);
  }

  /* Decorative line between panels */
  .split::before {
    content: '';
    position: absolute;
    width: 1px;
    background: rgba(255,255,255,0.08);
    top: 5%;
    bottom: 5%;
    left: 50%;
    z-index: 3;
  }

  @media (max-width: 640px) {
    .split {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .split::before { display: none; }
    .panel {
      min-height: 35vh;
      padding: 2rem;
    }
  }
</style>