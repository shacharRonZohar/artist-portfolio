---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  artist: string;
  label: string;
}

const { artist, label } = Astro.props;
const base = import.meta.env.BASE_URL;
const works = (await getCollection('art')).filter((w) => w.data.artist === artist);

const grouped = works.reduce<Record<string, CollectionEntry<'art'>[]>>((acc, work) => {
  const key = work.data.collection || 'Uncategorized';
  (acc[key] ??= []).push(work);
  return acc;
}, {});

const collections = Object.keys(grouped).sort((a, b) => a.localeCompare(b));
for (const key of collections) {
  grouped[key].sort((a, b) => b.data.order - a.data.order || b.data.date.getTime() - a.data.date.getTime());
}
---

<h1>{label}</h1>
{collections.map((collection) => (
  <section class="collection">
    <h2>{collection}</h2>
    <div class="gallery">
      {grouped[collection].map((work: CollectionEntry<'art'>) => (
        <a href={`${base}art/${work.slug}`} class="card">
          <img src={`${base}${work.data.image.replace(/^\//, '')}`} alt={work.data.title} loading="lazy" />
          <div class="info">
            <h3>{work.data.title}</h3>
            {work.data.medium && <span>{work.data.medium}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>
))}
{works.length === 0 && <p class="empty">No pieces yet.</p>}

<style>
  h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .collection {
    margin-bottom: 3.5rem;
  }

  .collection h2 {
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: capitalize;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #eee;
    color: var(--fg);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: opacity 0.2s;
  }
  .card:hover { opacity: 0.8; }

  .card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f0f0f0;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .info h3 {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .info span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
    font-size: 1rem;
  }
</style>