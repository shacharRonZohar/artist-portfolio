---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  artist: string;
  label: string;
}

const { artist, label } = Astro.props;
const base = import.meta.env.BASE_URL;
const works = (await getCollection('art'))
  .filter((w) => w.data.artist === artist)
  .sort((a, b) => b.data.order - a.data.order || b.data.date.getTime() - a.data.date.getTime());
---

<h1>{label}</h1>
<div class="gallery">
  {works.map((work: CollectionEntry<'art'>) => (
    <a href={`${base}art/${work.slug}`} class="card">
      <img src={`${base}${work.data.image.replace(/^\//, '')}`} alt={work.data.title} loading="lazy" />
      <div class="info">
        <h2>{work.data.title}</h2>
        {work.data.medium && <span>{work.data.medium}</span>}
      </div>
    </a>
  ))}
</div>
{works.length === 0 && <p class="empty">No pieces yet.</p>}

<style>
  h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: opacity 0.2s;
  }
  .card:hover { opacity: 0.8; }

  .card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f0f0f0;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info h2 {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .info span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .empty {
    color: var(--muted);
    font-size: 1rem;
  }
</style>